# AI Route Explorer Configuration Template
# Copy this to .env and fill in your actual values

# OpenRouteService API
# Get from: https://openrouteservice.org/register
OPENROUTE_API_KEY=your_api_key_here

# Ollama Configuration
# Default runs locally on port 11434
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=mistral

# Optional: Search APIs (for future integration)
TAVILY_API_KEY=optional_tavily_key
GOOGLE_PLACES_API_KEY=optional_google_places_key

# App Configuration
DEBUG=False
LOG_LEVEL=INFO
MAX_WAYPOINTS=10
